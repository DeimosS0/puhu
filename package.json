{
  "name": "puhu",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p puhu-hook",
    "prebuild": "cargo build --release -p puhu-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "phone-page": "node scripts/phone-page.mjs"
  },
  "devDependencies": {
    "@noble/ciphers": "2.4.0",
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
